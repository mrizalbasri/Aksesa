# Aksesa Environment Variables

# Backend & Security
DEBUG=true
SECRET_KEY=dev-aksesa-super-secret-key-2026-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For SQLite (default demo):
DATABASE_URL=sqlite+aiosqlite:////app/aksesa.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://aksesa:aksesapassword@postgres:5432/aksesa

# Azure AI Document Intelligence (OCR)
AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your_key_here

# Azure OpenAI (GPT-4o)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
